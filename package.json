{
  "name": "daily-ten",
  "private": true,
  "version": "0.0.0",
  "description": "Daily Ten 開發工具（僅 dev）：測試與檢查。App 本身沒有 build。",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "serve": "node tools/serve.mjs . 4173",
    "check:repo": "node .github/scripts/check-repo.mjs",
    "check:glossary": "node tools/jev/check-glossary.js --ci",
    "test:glossary": "node tools/jev/check-glossary.js --self-test",
    "dev:flow": "node tools/dev/flow.mjs",
    "lint": "eslint js tests",
    "lint:fix": "eslint js tests --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "js/**/*.js": [
      "eslint --fix"
    ],
    "tests/**/*.{js,mjs}": [
      "eslint --fix"
    ]
  }
}
